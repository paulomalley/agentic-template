#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# ==============================================================
# Comprehensive Pre-Commit Enforcement Hook
# Enforces rules from .clinerules/ mechanically.
#
# Skip individual checks with:
#   SKIP_TESTS=1 git commit         # skip all test/lint checks
#   SKIP_TDD=1 git commit           # skip TDD file-ratio check
#   SKIP_SMOKE=1 git commit         # skip smoke test
#   ALLOW_MULTI_FILE=1 git commit   # suppress multi-file warning
#   ALLOW_APPROVAL_SKIP=1 git commit # skip approvals doc check
#
# Emergency escape: git commit --no-verify
# ==============================================================

# Early exit if nothing staged
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
NON_TEST_STAGED=$(echo "$STAGED_FILES" | grep -vE '^tests/' | grep -vE '^\.husky/pre-commit$' || true)
SOURCE_STAGED=$(echo "$NON_TEST_STAGED" | grep -vE '\.(md|json|lock|yml|yaml|toml|cfg|ini)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✔ No staged files — skipping checks."
    exit 0
fi

# Color helpers (optional, fallback to plain)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
[ -t 1 ] || { RED=''; GREEN=''; YELLOW=''; NC=''; }

error_count=0
warning_count=0

echo ""
echo "━━━ Pre-Commit Enforcement Checks ━━━"
echo ""

# ================================================================
# CHECK 1: No dependency / build artifacts in staging
# ================================================================
BUILD_ARTIFACTS=$(echo "$STAGED_FILES" | grep -E '(node_modules|dist|build|coverage|\.env|\.venv|venv|__pycache__)' || true)
if [ -n "$BUILD_ARTIFACTS" ]; then
    echo "${RED}✖ BLOCKING: Build/cache files are staged:${NC}"
    echo "$BUILD_ARTIFACTS" | sed 's/^/   /'
    echo "   Run: git rm --cached <file> to unstage"
    error_count=$((error_count + 1))
fi

# ================================================================
# CHECK 2: No untracked cache/build files
# ================================================================
UNTRACKED_CACHE=$(git status --short | grep -E '^\?\?' | grep -E '(node_modules|dist|build|coverage|\.env)' || true)
if [ -n "$UNTRACKED_CACHE" ]; then
    echo "${YELLOW}⚠ WARNING: Untracked cache/build files detected:${NC}"
    echo "$UNTRACKED_CACHE" | sed 's/^/   /'
    echo "   Add them to .gitignore or delete them."
    warning_count=$((warning_count + 1))
fi

# ================================================================
# CHECK 3: Boundary-path integration tests (05a)
# ================================================================
BOUNDARY_FILES=$(echo "$STAGED_FILES" | grep -E '^(client/|server/src/routes/)' || true)
if [ -n "$BOUNDARY_FILES" ] && [ -z "$SKIP_TESTS" ] && [ -z "$SKIP_TDD" ]; then
    INTEGRATION_TESTS=$(echo "$STAGED_FILES" | grep -E '^tests/integration/' || true)
    if [ -z "$INTEGRATION_TESTS" ]; then
        echo "${YELLOW}⚠ WARNING: Boundary-path files changed but no integration tests in this commit:${NC}"
        echo "$BOUNDARY_FILES" | sed 's/^/   /'
        echo "   Per .clinerules/05a-integration-policy.md, boundary changes should"
        echo "   include integration tests (tests/integration/)."
        warning_count=$((warning_count + 1))
    fi
fi

# ================================================================
# CHECK 4: Smoke test for boundary-path changes (05a)
# ================================================================
if [ -n "$BOUNDARY_FILES" ] && [ -z "$SKIP_TESTS" ] && [ -z "$SKIP_SMOKE" ]; then
    SMOKE_CMD=$(npm run --silent 2>/dev/null | grep 'test:smoke' || echo '')
    if [ -n "$SMOKE_CMD" ]; then
        echo "   Running smoke tests (boundary-path change)..."
        if npm run test:smoke 2>/dev/null; then
            echo "${GREEN}   ✔ Smoke tests passed${NC}"
        else
            echo "${RED}✖ BLOCKING: Smoke tests failed. Fix before committing, or use SKIP_SMOKE=1.${NC}"
            error_count=$((error_count + 1))
        fi
    else
        echo "   Skipping smoke test — no test:smoke script configured."
    fi
fi

# ================================================================
# CHECK 5: TDD — source file changes should have corresponding test changes
# ================================================================
if [ -n "$SOURCE_STAGED" ] && [ -z "$SKIP_TESTS" ] && [ -z "$SKIP_TDD" ] && [ -d "src" ]; then
    MISSING_TESTS=""
    for src_file in $SOURCE_STAGED; do
        # Map src/foo/bar.ts → tests/unit/foo/bar.test.ts
        test_file=$(echo "$src_file" | sed 's|^src/|tests/unit/|' | sed 's|\.\(ts\|tsx\|js\|jsx\)$|.test.\1|')
        test_exists=0
        for variant in "$test_file" "${test_file%.test.ts}.spec.ts" "${test_file%.test.js}.spec.js"; do
            if echo "$STAGED_FILES" | grep -qF "$variant"; then
                test_exists=1
                break
            fi
        done
        if [ "$test_exists" -eq 0 ]; then
            MISSING_TESTS="$MISSING_TESTS   $src_file → no corresponding test found in staged changes\n"
        fi
    done

    if [ -n "$MISSING_TESTS" ]; then
        echo "${YELLOW}⚠ WARNING: Source files changed without corresponding test changes:${NC}"
        printf "%b" "$MISSING_TESTS"
        echo "   Per .clinerules/05-phase-gate-policy.md, code and tests should be generated together."
        echo "   (Non-blocking — your test may already exist or this is a refactor.)"
        warning_count=$((warning_count + 1))
    fi
fi

# ================================================================
# CHECK 6: Multi-file transform gate (04)
# ================================================================
SOURCE_FILE_COUNT=$(echo "$SOURCE_STAGED" | wc -l)
if [ "$SOURCE_FILE_COUNT" -gt 3 ] && [ -z "$ALLOW_MULTI_FILE" ]; then
    echo "${YELLOW}⚠ WARNING: $SOURCE_FILE_COUNT non-test source files changed in this commit.${NC}"
    echo "   Per .clinerules/04-state-control.md, changes touching >3 distinct source files"
    echo "   should be reviewed as a multi-file transform."
    echo "   To override: ALLOW_MULTI_FILE=1 git commit"
    warning_count=$((warning_count + 1))
fi

# ================================================================
# CHECK 7: Approvals doc for feature-level commits (05)
# ================================================================
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" | head -1)
    # Heuristic: commits touching .clinerules/ or docs/ (Feature-level) should update approvals.md
    FEATURE_CONTEXT=$(echo "$STAGED_FILES" | grep -E '^\.clinerules/|^docs/' || true)
    APPROVALS_UPDATED=$(echo "$STAGED_FILES" | grep -E '^docs/approvals\.md$' || true)

    if [ -n "$FEATURE_CONTEXT" ] && [ -z "$APPROVALS_UPDATED" ] && [ -z "$ALLOW_APPROVAL_SKIP" ]; then
        # Only warn if it looks like a feature commit, not a doc-only update
        APPROVAL_NEEDED=$(echo "$STAGED_FILES" | grep -c -E '\.clinerules/0[0-9]' || true)
        if [ "$APPROVAL_NEEDED" -gt 0 ]; then
            echo "${YELLOW}⚠ Consider updating docs/approvals.md for this change.${NC}"
            echo "   Per .clinerules/05-phase-gate-policy.md."
            echo "   To suppress: ALLOW_APPROVAL_SKIP=1 git commit"
            warning_count=$((warning_count + 1))
        fi
    fi
fi

# ================================================================
# CHECK 8: Lint check (03 — zero warnings policy)
# ================================================================
LINT_CMD=$(npm run --silent 2>/dev/null | grep 'test:lint' || echo '')
if [ -n "$LINT_CMD" ] && [ -z "$SKIP_TESTS" ]; then
    echo "   Running linter..."
    if npm run test:lint 2>/dev/null; then
        echo "${GREEN}   ✔ Lint passed${NC}"
    else
        echo "${RED}✖ BLOCKING: Lint failed. Per .clinerules/03-code-by-constraint.md — zero warnings policy.${NC}"
        error_count=$((error_count + 1))
    fi
else
    echo "   Skipping lint — no test:lint script configured."
fi

# ================================================================
# CHECK 9: Test count guard — ensure tests aren't silently shrinking
# ================================================================
if [ -z "$SKIP_TESTS" ] && [ -d "tests" ]; then
    ADDED_TESTS=$(echo "$STAGED_FILES" | grep -cE '^tests/.*\.test\.' || true)
    REMOVED_TESTS=$(git diff --cached --name-only --diff-filter=D | grep -cE '^tests/.*\.test\.' || true)
    if [ "$REMOVED_TESTS" -gt 0 ] && [ "$REMOVED_TESTS" -ge "$ADDED_TESTS" ]; then
        echo "${YELLOW}⚠ WARNING: $REMOVED_TESTS test(s) removed, $ADDED_TESTS test(s) added.${NC}"
        echo "   If intentional, re-run with: git commit --no-verify"
        warning_count=$((warning_count + 1))
    fi
fi

# ================================================================
# Summary
# ================================================================
echo ""
echo "━━━ Summary ━━━"
echo "   ${GREEN}$(echo "$STAGED_FILES" | grep -c '' || echo 0) files staged${NC}"

if [ "$error_count" -gt 0 ]; then
    echo "   ${RED}$error_count blocking issue(s) — commit blocked.${NC}"
    echo ""
    echo "Fix the issues above, or use 'git commit --no-verify' to bypass."
    exit 1
fi

if [ "$warning_count" -gt 0 ]; then
    echo "   ${YELLOW}$warning_count warning(s) — review recommended.${NC}"
else
    echo "   ${GREEN}All checks passed.${NC}"
fi

echo ""
exit 0